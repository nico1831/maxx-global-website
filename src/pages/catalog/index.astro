---
import Layout from '../../layouts/Layout.astro'
import ProductCard from '../../components/ProductCard.astro'
import { client } from '../../lib/sanity'
import { catalogProductsQuery, categoryTreeQuery, allBrandsQuery } from '../../lib/queries'

const [products, categoriesRaw, brands] = await Promise.all([
  client.fetch(catalogProductsQuery),
  client.fetch(categoryTreeQuery),
  client.fetch(allBrandsQuery),
])

// Flooring and playground are separate product lines — keep them below the core equipment categories
const TRAILING_CATS = new Set(['flooring', 'playground'])
const categories = [...categoriesRaw]
  .sort((a: any, b: any) => {
    const rank = (cat: any) => (TRAILING_CATS.has(cat.slug.current) ? 1 : 0)
    return rank(a) - rank(b)
  })
  .map((cat: any) => ({
    ...cat,
    // "Other X" catch-all subcategories always sort last within their category
    children: cat.children?.length
      ? [...cat.children].sort((a: any, b: any) => {
          const rank = (sub: any) => (/^other\b/i.test(sub.title) ? 1 : 0)
          return rank(a) - rank(b)
        })
      : cat.children,
  }))

// Per design.md §5: only Available and Indent Order shown in availability filter
const AVAIL_FILTER = [
  { value: 'available', label: 'Available', color: '#8fb79b' },
  { value: 'indent',    label: 'Indent Order', color: '#c2a768' },
]
---

<Layout title="Catalog — Maxx Global Resources" description="Every commercial fitness, flooring and playground line we carry. Prices quoted per project." active="Catalog">
  <div class="catalog-header">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span>Catalog</span>
    </div>
    <div class="catalog-meta">
      <div class="catalog-intro">
        <h1>The commercial catalog</h1>
        <p>Every line we carry, including the flooring and playground ranges you won't find on our consumer store. Prices are quoted per project — every product page carries the manufacturer spec sheet.</p>
      </div>
      <div class="result-wrap">
        <div class="result-num" id="result-count">{products.length}</div>
        <div class="result-label">Products shown</div>
      </div>
    </div>
  </div>

  <div class="catalog-body">
    <!-- ── FILTER SIDEBAR ── -->
    <aside class="filter-sidebar" aria-label="Product filters">
      <div class="filter-top">
        <span class="filter-heading">Filters</span>
        <button id="clear-all" class="clear-btn" aria-label="Clear all filters">Clear all</button>
      </div>

      <!-- Category -->
      <div class="filter-group">
        <button class="filter-group-header" data-group-toggle="category" aria-expanded="true">
          <span class="filter-group-label">Category</span>
          <svg class="group-arrow" width="14" height="14" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1.5 3L5 6.5L8.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="filter-rows" id="cat-rows" data-group-panel="category">
          {categories.map((cat: any) => (
            <div class="cat-item" data-cat-key={cat.slug.current}>
              <div class="cat-row-wrap">
                <button
                  class="filter-row check-row cat-main"
                  data-filter="cat"
                  data-value={cat.slug.current}
                  aria-pressed="false"
                >
                  <span class="check-box" aria-hidden="true"></span>
                  <span>{cat.title}</span>
                </button>
                {cat.children?.length > 0 && (
                  <button
                    class="cat-toggle"
                    data-toggle={cat.slug.current}
                    aria-expanded="false"
                    aria-label={`Toggle ${cat.title} subcategories`}
                  >
                    <svg width="14" height="14" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                      <path d="M1.5 3L5 6.5L8.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                )}
              </div>
              {cat.children?.length > 0 && (
                <div class="sub-rows" id={`sub-${cat.slug.current}`} hidden>
                  {cat.children.map((sub: any) => (
                    <button
                      class="filter-row sub check-row"
                      data-filter="sub"
                      data-value={sub.slug.current}
                      data-parent={cat.slug.current}
                      aria-pressed="false"
                    >
                      <span class="check-box" aria-hidden="true"></span>
                      <span>{sub.title}</span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Brand -->
      <div class="filter-group">
        <button class="filter-group-header" data-group-toggle="brand" aria-expanded="true">
          <span class="filter-group-label">Brand</span>
          <svg class="group-arrow" width="14" height="14" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1.5 3L5 6.5L8.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="filter-rows" data-group-panel="brand">
          {brands.map((b: any) => (
            <button
              class="filter-row check-row"
              data-filter="brand"
              data-value={b.slug.current}
              aria-pressed="false"
            >
              <span class="check-box" aria-hidden="true"></span>
              <span>{b.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Availability -->
      <div class="filter-group">
        <button class="filter-group-header" data-group-toggle="availability" aria-expanded="true">
          <span class="filter-group-label">Availability</span>
          <svg class="group-arrow" width="14" height="14" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1.5 3L5 6.5L8.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="filter-rows" data-group-panel="availability">
          {AVAIL_FILTER.map(a => (
            <button
              class="filter-row check-row"
              data-filter="avail"
              data-value={a.value}
              aria-pressed="false"
            >
              <span class="check-box" aria-hidden="true"></span>
              <span style={`color:${a.color}`}>{a.label}</span>
            </button>
          ))}
        </div>
      </div>
    </aside>

    <!-- ── PRODUCT GRID ── -->
    <div class="catalog-main">
      <!-- Active filter chips -->
      <div class="active-chips" id="active-chips" hidden>
        <span class="chips-label">Active:</span>
        <div class="chips-row" id="chips-row"></div>
      </div>

      <!-- Grid -->
      <div class="product-grid" id="product-grid">
        {products.map((p: any) => (
          <div
            class="product-wrapper"
            data-brand={p.brand?.slug?.current}
            data-cat={p.primaryCategory?.parent?.slug?.current ?? p.primaryCategory?.slug?.current}
            data-sub={p.primaryCategory?.parent ? p.primaryCategory.slug.current : ''}
            data-avail={p.availability}
          >
            <ProductCard product={p} />
          </div>
        ))}
      </div>

      <!-- No results -->
      <div class="no-results" id="no-results" hidden>
        <div class="no-results-title">Nothing matches that combination.</div>
        <p class="no-results-body">Clear a filter, or tell us what you're looking for — we source outside the published range regularly.</p>
        <a href="/contact" class="btn-primary">Ask our sales team</a>
      </div>

      <!-- Pagination -->
      <nav class="pagination" id="pagination" aria-label="Catalog pages" hidden>
        <button class="page-btn page-prev" id="page-prev" aria-label="Previous page">
          <svg width="14" height="14" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M6.5 1.5L3 5L6.5 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Prev</span>
        </button>
        <div class="page-numbers" id="page-numbers"></div>
        <button class="page-btn page-next" id="page-next" aria-label="Next page">
          <span>Next</span>
          <svg width="14" height="14" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M3.5 1.5L7 5L3.5 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </nav>
    </div>
  </div>
</Layout>

<style>
  /* ── PAGE HEADER ── */
  .catalog-header {
    padding: 48px clamp(20px,5vw,48px) 36px;
    border-bottom: 1px solid #1e1e1e;
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 12px;
    color: #5a5a56;
    margin-bottom: 16px;
  }
  .breadcrumb a { color: #5a5a56; }
  .breadcrumb a:hover { color: #fff; }
  .catalog-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
  }
  .catalog-intro { max-width: 720px; }
  .catalog-intro h1 {
    margin: 0 0 14px;
    font-size: clamp(28px,5.5vw,46px);
    font-weight: 300;
    letter-spacing: -.01em;
    color: #fff;
  }
  .catalog-intro p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #9a9a96;
  }
  .result-wrap { flex: none; text-align: right; }
  .result-num {
    font-size: clamp(23px,4vw,34px);
    font-weight: 300;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .result-label {
    font-size: 12px;
    color: #8a8a86;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* ── TWO-COLUMN LAYOUT ── */
  .catalog-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  /* ── SIDEBAR ── */
  .filter-sidebar {
    flex: 1 1 250px;
    min-width: 0;
    position: sticky;
    top: 112px;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #3a3a38 transparent;
    padding: 32px 28px 48px;
    border-right: 1px solid #1e1e1e;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .filter-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .filter-heading {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #fff;
  }
  .clear-btn {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    font: 600 12px Manrope, sans-serif;
    color: #4a4a48;
    transition: color .15s;
  }
  .clear-btn.has-active { color: #d92632; }
  .filter-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0 0 14px;
    margin: 0;
    cursor: pointer;
    color: inherit;
  }
  .filter-group-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #8a8a86;
  }
  .filter-group-header:hover .filter-group-label { color: #fff; }
  .filter-group-header .group-arrow {
    flex: none;
    color: #6a6a66;
    transition: transform .15s, color .15s;
    transform: rotate(-90deg);
  }
  .filter-group-header:hover .group-arrow { color: #fff; }
  .filter-group-header[aria-expanded="true"] .group-arrow { transform: rotate(0deg); }
  .filter-rows { display: flex; flex-direction: column; gap: 2px; }
  .filter-rows[hidden] { display: none; }

  .filter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 4px;
    cursor: pointer;
    font: 500 13px Manrope, sans-serif;
    color: #c9c9c6;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    transition: background .15s, color .15s;
  }
  .filter-row:hover { background: #111; color: #fff; }
  .filter-row[aria-pressed="true"] {
    background: #1a1a18;
    color: #fff;
    font-weight: 600;
  }
  .filter-row.sub {
    padding: 6px 10px;
    font-size: 12.5px;
  }
  .check-row { justify-content: flex-start; }
  .check-box {
    width: 15px;
    height: 15px;
    flex: none;
    border-radius: 3px;
    border: 1px solid #3a3a38;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 10px Manrope, sans-serif;
    color: #fff;
    transition: background .12s, border-color .12s;
    margin-right: 4px;
  }
  .filter-row[aria-pressed="true"] .check-box {
    background: #d92632;
    border-color: #d92632;
  }
  .filter-row[aria-pressed="true"] .check-box::after { content: '✓'; }

  .cat-row-wrap { display: flex; align-items: center; gap: 2px; }
  .cat-row-wrap .cat-main { flex: 1 1 auto; }
  .cat-toggle {
    flex: none;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6a6a66;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .cat-toggle:hover { background: #111; color: #fff; }
  .cat-toggle svg { transition: transform .15s; transform: rotate(-90deg); }
  .cat-toggle[aria-expanded="true"] svg { transform: rotate(0deg); }
  .sub-rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 4px 0 8px 12px;
    border-left: 1px solid #242422;
    margin-left: 8px;
  }
  .sub-rows[hidden] { display: none; }

  /* ── MAIN AREA ── */
  .catalog-main {
    flex: 999 1 62%;
    min-width: 0;
    padding: 32px clamp(20px,5vw,48px) 88px;
  }

  .active-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 24px;
  }
  .active-chips[hidden] { display: none; }
  .chips-label { font-size: 12px; color: #8a8a86; margin-right: 4px; }
  .chips-row { display: flex; gap: 8px; flex-wrap: wrap; }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .no-results {
    border: 1px solid #1e1e1e;
    border-radius: 6px;
    background: #0d0d0d;
    padding: 72px clamp(20px,5vw,48px);
    text-align: center;
  }
  .no-results-title { font-size: 22px; font-weight: 300; margin-bottom: 10px; color: #fff; }
  .no-results-body { margin: 0 0 24px; font-size: 15px; color: #9a9a96; }

  /* ── PAGINATION ── */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin-top: 56px;
  }
  .pagination[hidden] { display: none; }

  /* ── SINGLE COLUMN (keep in sync with narrowLayout in the script below) ──
     Filters sit above the grid here, so the sidebar can't stay sticky: it would
     pin to the viewport and the products would scroll underneath it. */
  @media (max-width: 767px) {
    .catalog-body { display: block; }
    .filter-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      gap: 16px;
      padding: 20px clamp(20px,5vw,48px);
      border-right: none;
      border-bottom: 1px solid #1e1e1e;
    }
    .catalog-main { padding-top: 24px; }
    /* min() keeps a card from overflowing the gutter on the narrowest phones */
    .product-grid { grid-template-columns: repeat(auto-fill, minmax(min(190px, 100%), 1fr)); gap: 10px; }
  }
  @media (max-width: 420px) {
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  }
</style>

<script>
  // Filter state
  const state = {
    cat: null as string | null,
    sub: null as string | null,
    brands: new Set<string>(),
    avails: new Set<string>(),
  }
  const expanded = new Set<string>()
  // Filter groups start collapsed in the single-column layout so products aren't
  // pushed a full screen down the page
  const narrowLayout = window.matchMedia('(max-width: 767px)')
  const FILTER_GROUPS = ['category', 'brand', 'availability']
  const groupExpanded = new Set<string>(narrowLayout.matches ? [] : FILTER_GROUPS)

  const PAGE_SIZE = 24
  let page = 1

  function applyFilters() {
    const wrappers = Array.from(document.querySelectorAll<HTMLElement>('.product-wrapper'))

    const matches = wrappers.filter(el => {
      const brand = el.dataset.brand ?? ''
      const cat   = el.dataset.cat ?? ''
      const sub   = el.dataset.sub ?? ''
      const avail = el.dataset.avail ?? ''

      const brandOk = state.brands.size === 0 || state.brands.has(brand)
      const catOk   = !state.cat || cat === state.cat
      const subOk   = !state.sub || sub === state.sub
      const availOk = state.avails.size === 0 || state.avails.has(avail)

      return brandOk && catOk && subOk && availOk
    })

    const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE))
    page = Math.min(Math.max(page, 1), totalPages)
    const start = (page - 1) * PAGE_SIZE
    const pageItems = new Set(matches.slice(start, start + PAGE_SIZE))

    wrappers.forEach(el => { el.style.display = pageItems.has(el) ? '' : 'none' })

    const countEl = document.getElementById('result-count')
    if (countEl) countEl.textContent = String(matches.length)

    const noResults = document.getElementById('no-results')!
    noResults.hidden = matches.length > 0

    updateChips()
    updateClearBtn()
    updateButtonStates()
    updateSubRows()
    renderPagination(totalPages)
  }

  function renderPagination(totalPages: number) {
    const nav = document.getElementById('pagination')!
    const numbers = document.getElementById('page-numbers')!
    const prevBtn = document.getElementById('page-prev') as HTMLButtonElement
    const nextBtn = document.getElementById('page-next') as HTMLButtonElement

    nav.hidden = totalPages <= 1
    if (totalPages <= 1) {
      numbers.innerHTML = ''
      prevBtn.disabled = true
      nextBtn.disabled = true
      return
    }

    prevBtn.disabled = page === 1
    nextBtn.disabled = page === totalPages

    // Build a compact list of page numbers with ellipsis, e.g. 1 … 4 5 6 … 12
    const pages: (number | '…')[] = []
    const addPage = (n: number) => pages.push(n)
    const addEllipsis = () => { if (pages[pages.length - 1] !== '…') pages.push('…') }

    for (let n = 1; n <= totalPages; n++) {
      if (n === 1 || n === totalPages || Math.abs(n - page) <= 1) {
        addPage(n)
      } else {
        addEllipsis()
      }
    }

    numbers.innerHTML = ''
    pages.forEach(p => {
      if (p === '…') {
        const span = document.createElement('span')
        span.className = 'page-ellipsis'
        span.textContent = '…'
        numbers.appendChild(span)
      } else {
        const btn = document.createElement('button')
        btn.className = `page-num${p === page ? ' active' : ''}`
        btn.textContent = String(p)
        btn.setAttribute('aria-current', p === page ? 'true' : 'false')
        btn.addEventListener('click', () => { page = p; applyFilters(); scrollToGrid() })
        numbers.appendChild(btn)
      }
    })
  }

  function scrollToGrid() {
    document.getElementById('product-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  function updateSubRows() {
    document.querySelectorAll<HTMLElement>('.sub-rows').forEach(el => {
      const parentCat = el.id.replace('sub-', '')
      el.hidden = !expanded.has(parentCat)
    })
    document.querySelectorAll<HTMLButtonElement>('.cat-toggle').forEach(btn => {
      btn.setAttribute('aria-expanded', String(expanded.has(btn.dataset.toggle!)))
    })
  }

  function updateButtonStates() {
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(btn => {
      const filter = btn.dataset.filter!
      const value  = btn.dataset.value!
      let pressed = false
      if (filter === 'cat')   pressed = state.cat === value
      if (filter === 'sub')   pressed = state.sub === value
      if (filter === 'brand') pressed = state.brands.has(value)
      if (filter === 'avail') pressed = state.avails.has(value)
      btn.setAttribute('aria-pressed', String(pressed))
    })
  }

  function updateClearBtn() {
    const hasAny = state.cat || state.sub || state.brands.size > 0 || state.avails.size > 0
    document.getElementById('clear-all')?.classList.toggle('has-active', !!hasAny)
  }

  function updateChips() {
    const chipsWrap = document.getElementById('active-chips')!
    const chipsRow  = document.getElementById('chips-row')!
    chipsRow.innerHTML = ''

    const chips: { label: string; clear: () => void }[] = []

    if (state.cat) {
      const btn = document.querySelector<HTMLElement>(`[data-filter="cat"][data-value="${state.cat}"]`)
      chips.push({ label: btn?.querySelector('span:last-child')?.textContent ?? state.cat, clear: () => { state.cat = null; state.sub = null } })
    }
    if (state.sub) {
      const btn = document.querySelector<HTMLElement>(`[data-filter="sub"][data-value="${state.sub}"]`)
      chips.push({ label: btn?.querySelector('span:last-child')?.textContent ?? state.sub, clear: () => { state.sub = null } })
    }
    state.brands.forEach(v => {
      const btn = document.querySelector<HTMLElement>(`[data-filter="brand"][data-value="${v}"]`)
      chips.push({ label: btn?.querySelector('span:last-child')?.textContent ?? v, clear: () => state.brands.delete(v) })
    })
    state.avails.forEach(v => {
      const btn = document.querySelector<HTMLElement>(`[data-filter="avail"][data-value="${v}"]`)
      chips.push({ label: btn?.querySelector('span:last-child')?.textContent ?? v, clear: () => state.avails.delete(v) })
    })

    chipsWrap.hidden = chips.length === 0

    chips.forEach(c => {
      const chip = document.createElement('button')
      chip.className = 'chip'
      chip.innerHTML = `${c.label} <span aria-hidden="true">✕</span>`
      chip.addEventListener('click', () => { c.clear(); page = 1; applyFilters() })
      chipsRow.appendChild(chip)
    })
  }

  // Wire up filter buttons
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!
      const value  = btn.dataset.value!

      if (filter === 'cat') {
        state.cat = state.cat === value ? null : value
        state.sub = null
        if (state.cat) expanded.add(state.cat)
      } else if (filter === 'sub') {
        state.sub = state.sub === value ? null : value
      } else if (filter === 'brand') {
        state.brands.has(value) ? state.brands.delete(value) : state.brands.add(value)
      } else if (filter === 'avail') {
        state.avails.has(value) ? state.avails.delete(value) : state.avails.add(value)
      }

      page = 1
      applyFilters()
    })
  })

  // Wire up pagination prev/next
  document.getElementById('page-prev')?.addEventListener('click', () => { page--; applyFilters(); scrollToGrid() })
  document.getElementById('page-next')?.addEventListener('click', () => { page++; applyFilters(); scrollToGrid() })

  // Wire up category expand/collapse arrows
  document.querySelectorAll<HTMLButtonElement>('.cat-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation()
      const key = btn.dataset.toggle!
      expanded.has(key) ? expanded.delete(key) : expanded.add(key)
      updateSubRows()
    })
  })

  // Wire up filter-group collapse/expand headers
  function updateGroupPanels() {
    document.querySelectorAll<HTMLButtonElement>('[data-group-toggle]').forEach(header => {
      const key = header.dataset.groupToggle!
      const isOpen = groupExpanded.has(key)
      header.setAttribute('aria-expanded', String(isOpen))
      const panel = document.querySelector<HTMLElement>(`[data-group-panel="${key}"]`)
      if (panel) panel.hidden = !isOpen
    })
  }
  document.querySelectorAll<HTMLButtonElement>('[data-group-toggle]').forEach(header => {
    header.addEventListener('click', () => {
      const key = header.dataset.groupToggle!
      groupExpanded.has(key) ? groupExpanded.delete(key) : groupExpanded.add(key)
      updateGroupPanels()
    })
  })
  narrowLayout.addEventListener('change', (e) => {
    groupExpanded.clear()
    if (!e.matches) FILTER_GROUPS.forEach(key => groupExpanded.add(key))
    updateGroupPanels()
  })
  updateGroupPanels()

  // Clear all
  document.getElementById('clear-all')?.addEventListener('click', () => {
    state.cat = null; state.sub = null; state.brands.clear(); state.avails.clear()
    page = 1
    applyFilters()
  })

  // Pre-select filters passed in via the URL (e.g. /catalog?brand=sportsart)
  const urlParams = new URLSearchParams(window.location.search)
  const brandParam = urlParams.get('brand')
  if (brandParam) state.brands.add(brandParam)
  const catParam = urlParams.get('category')
  if (catParam) { state.cat = catParam; expanded.add(catParam) }
  const subParam = urlParams.get('sub')
  if (subParam) state.sub = subParam

  // Initial render
  applyFilters()
</script>

