---
import Layout from '../layouts/Layout.astro'
import { client, urlFor } from '../lib/sanity'
import { projectsQuery } from '../lib/queries'

const projects = await client.fetch(projectsQuery)

// Publicly shown name depends on the permission the client gave us
function displayName(project: any) {
  if (project.displayAs === 'full') return project.clientName || project.title
  return project.anonymisedLabel || 'Undisclosed client'
}

const years = projects.map((p: any) => p.year).filter(Boolean)
const earliestYear = years.length > 0 ? Math.min(...years) : null
const locationCount = new Set(
  projects.map((p: any) => p.location).filter(Boolean),
).size
---

<Layout
  title="Projects — Maxx Global Resources"
  description="Completed installations across the Philippines — hotel gyms, condominium amenities, school facilities and LGU playgrounds, specified and installed by our own team."
  active="Projects"
>
  <div class="projects-header">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span>Projects</span>
    </div>
    <div class="eyebrow">
      <span class="eyebrow-bar"></span>
      <span class="eyebrow-label">Installations</span>
    </div>
    <h1>Proof, delivered.</h1>
    <p>From five-star hotel gyms in Makati to municipal playgrounds in Mindanao — every project below was specified, imported and installed by our own team. Some clients are named with their written permission; the rest stay anonymous by request.</p>

    {projects.length > 0 && (
      <div class="stat-strip">
        <div class="stat-cell">
          <div class="stat-value">{projects.length}</div>
          <div class="stat-label">Projects shown</div>
        </div>
        {locationCount > 0 && (
          <div class="stat-cell">
            <div class="stat-value">{locationCount}</div>
            <div class="stat-label">Locations</div>
          </div>
        )}
        {earliestYear && (
          <div class="stat-cell">
            <div class="stat-value">{earliestYear}</div>
            <div class="stat-label">Earliest on record</div>
          </div>
        )}
      </div>
    )}
  </div>

  <div class="projects-body">
    {projects.length > 0 ? (
      <div class="projects-grid">
        {projects.map((project: any) => {
          const imageUrl = project.image?.asset
            ? urlFor(project.image).width(900).height(600).fit('crop').url()
            : null
          return (
            <article class="project-card">
              <div class="project-photo">
                {imageUrl ? (
                  <img src={imageUrl} alt={project.image.alt || displayName(project)} loading="lazy">
                ) : (
                  <span class="project-photo-ph">[ installation photo ]</span>
                )}
                {project.isFeatured && <span class="project-badge">Featured</span>}
              </div>
              <div class="project-info">
                <div class="project-name">{displayName(project)}</div>
                <div class="project-meta">
                  {[project.segmentName, project.location, project.year]
                    .filter(Boolean)
                    .join(' · ')}
                </div>
                {project.summary && <p class="project-summary">{project.summary}</p>}
                {project.brandsUsed?.length > 0 && (
                  <div class="project-brands">
                    {project.brandsUsed.map((brand: any) => (
                      <a href={`/brands/${brand.slug.current}`} class="project-brand-tag">{brand.name}</a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          )
        })}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-title">Our project record isn't public yet</div>
        <p class="empty-text">
          We install under confidentiality for most of our hotel and corporate clients, and we only publish a project once written permission is on file. That paperwork is in progress.
        </p>
        <p class="empty-text">
          In the meantime we're glad to walk you through comparable installations directly — including site photos, equipment lists and client references we're cleared to share.
        </p>
        <div class="empty-actions">
          <a href="/contact" class="btn-primary">Ask for references</a>
          <a href="/brands" class="btn-secondary">See the brands we carry</a>
        </div>
      </div>
    )}
  </div>

  <div class="projects-cta">
    <h2>Planning a facility?</h2>
    <p>Tell us the floor area and the opening date — we'll come back with a quoted package covering equipment, flooring, delivery and installation.</p>
    <a href="/contact" class="btn-primary">Request a Quote</a>
  </div>
</Layout>

<style>
  /* ── PAGE HEADER ── */
  .projects-header {
    padding: 48px clamp(20px,5vw,48px) 40px;
    border-bottom: 1px solid #1e1e1e;
  }
  .breadcrumb {
    display: flex; gap: 8px; align-items: center;
    font-size: 12px; color: #5a5a56; margin-bottom: 16px;
  }
  .breadcrumb a { color: #5a5a56; }
  .breadcrumb a:hover { color: #fff; }
  .projects-header h1 {
    margin: 0 0 14px;
    font-size: clamp(28px,5.5vw,46px);
    font-weight: 300; letter-spacing: -.01em; color: #fff;
  }
  .projects-header p {
    margin: 0; max-width: 680px;
    font-size: 16px; line-height: 1.65; color: #9a9a96;
  }

  .stat-strip {
    display: flex; flex-wrap: wrap; gap: 48px; margin-top: 32px;
  }
  .stat-value { font-size: 30px; font-weight: 300; color: #fff; line-height: 1; }
  .stat-label {
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    color: #5a5a56; margin-top: 8px;
  }

  /* ── GRID ── */
  .projects-body { padding: 40px clamp(20px,5vw,48px) 0; }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px,100%), 1fr));
    gap: 16px;
  }
  .project-card {
    border: 1px solid #1e1e1e;
    border-radius: 6px;
    background: #0d0d0d;
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: border-color .15s;
  }
  .project-card:hover { border-color: #3a3a38; }
  .project-photo {
    position: relative;
    aspect-ratio: 3 / 2;
    background: #121212;
    display: flex; align-items: center; justify-content: center;
  }
  .project-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .project-photo-ph { color: #3a3a38; font: 11px ui-monospace, monospace; }
  .project-badge {
    position: absolute; top: 12px; left: 12px;
    background: #d92632; color: #fff; border-radius: 100px;
    padding: 5px 12px; font-size: 11px; font-weight: 600;
    letter-spacing: .06em; text-transform: uppercase;
  }
  .project-info { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .project-name { font-size: 17px; font-weight: 600; color: #fff; line-height: 1.35; }
  .project-meta { font-size: 12px; color: #5a5a56; letter-spacing: .02em; }
  .project-summary {
    margin: 4px 0 0;
    font-size: 14px; line-height: 1.65; color: #8a8a86;
  }
  .project-brands { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .project-brand-tag {
    font-size: 12px; font-weight: 600; color: #9a9a96;
    border: 1px solid #2a2a28; border-radius: 100px;
    padding: 5px 12px; text-decoration: none; transition: border-color .15s, color .15s;
  }
  .project-brand-tag:hover { border-color: #5b8def; color: #5b8def; }

  /* ── EMPTY STATE ── */
  .empty-state {
    border: 1px solid #1e1e1e;
    border-radius: 6px;
    background: #0d0d0d;
    padding: clamp(32px,6vw,64px);
    max-width: 760px;
  }
  .empty-title {
    font-size: clamp(20px,3.5vw,26px); font-weight: 300;
    color: #fff; margin-bottom: 16px;
  }
  .empty-text {
    margin: 0 0 14px; max-width: 580px;
    font-size: 15px; line-height: 1.7; color: #8a8a86;
  }
  .empty-actions {
    display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px;
  }

  /* ── CTA ── */
  .projects-cta {
    margin: 72px clamp(20px,5vw,48px) 88px;
    padding: clamp(32px,6vw,64px);
    border: 1px solid #1e1e1e; border-radius: 6px;
    background: #0d0d0d; text-align: center;
  }
  .projects-cta h2 {
    margin: 0 0 14px;
    font-size: clamp(24px,4vw,34px); font-weight: 300; color: #fff;
  }
  .projects-cta p {
    margin: 0 auto 28px; max-width: 540px;
    font-size: 15px; line-height: 1.65; color: #9a9a96;
  }
</style>
