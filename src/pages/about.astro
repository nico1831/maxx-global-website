---
import Layout from '../layouts/Layout.astro'

// Stats match the homepage ticker and are still pending client confirmation (PRD F7).
const stats = [
  { num: '250', plus: true, label: 'Installations completed' },
  { num: '30', plus: true, label: 'Provinces served' },
  { num: '10', plus: false, label: 'Principal brands held' },
  { num: '2007', plus: false, label: 'Operating since' },
]

// Client-supplied copy, kept verbatim (PRD F7).
const valuesTop = [
  { num: '01', body: 'Our professional team will advise you about which products is more better adapted to your needs.' },
  { num: '02', body: 'Our passion drives us to deliver outstanding results.' },
  { num: '03', body: 'We constantly innovate to surpass expectations & reach new heights' },
]
const valuesBottom = [
  { num: '04', body: 'The quality in our products and the commitment with the customer represent an obsession for us.' },
  { num: '05', body: 'We do things right with integrity every step of our business as we pursuit to make a difference for the glory of God.' },
]
---

<Layout
  title="About Us — Maxx Global Resources"
  description="Maxx Global Resources Corporation has been a recognized provider of high-quality fitness equipment in the Philippines since 2007."
  active="About"
>
  <!-- ════════════════════ INTRO ════════════════════ -->
  <section class="about-intro">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span>About</span>
    </div>
    <div class="eyebrow">
      <span class="eyebrow-bar"></span>
      <span class="eyebrow-label">Maxx Global Resources Corporation</span>
    </div>
    <h1>About Us</h1>
    <p>MAXX GLOBAL RESOURCES CORPORATION has been a well- established and recognized provider of high-quality fitness equipment since 2007. Our strong business partnership with our foreign suppliers have paved the way for us to have a wide experience of professional expertise in offering a comprehensive choice of fitness selections. Over a decade later, we extend our product portfolio by providing premium home and consumer equipment that are easily accessible, economical, and of uncompromised exceptional value.</p>
  </section>

  <!-- ════════════════════ STATS ════════════════════ -->
  <div class="stat-bar">
    {stats.map((s) => (
      <div class="stat-cell">
        <div class="stat-num">{s.num}{s.plus && <span class="stat-plus">+</span>}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>

  <!-- ════════════════════ MISSION / VISION ════════════════════ -->
  <div class="mv-grid">
    <div class="mv-cell">
      <div class="eyebrow">
        <span class="eyebrow-bar"></span>
        <span class="eyebrow-label">Mission</span>
      </div>
      <p>At Maxx Global we offer complete solutions appropriate to your wellness needs with high quality &amp; value oriented products &amp; services.</p>
    </div>
    <div class="mv-cell">
      <div class="eyebrow">
        <span class="eyebrow-bar"></span>
        <span class="eyebrow-label">Vision</span>
      </div>
      <p>Maxx Global has the objective to be the preferred partner with a great brands targeted at the commercial fitness/ wellness markets in the Philippines that bring an added value.</p>
    </div>
  </div>

  <!-- ════════════════════ CORE VALUES ════════════════════ -->
  <section class="values">
    <h2>Our Core Values</h2>
    <p class="values-lead">We are aimed at you:</p>
    <div class="values-panel">
      <div class="values-row values-row-top">
        {valuesTop.map((v) => (
          <div class="value-card">
            <div class="value-num">{v.num}</div>
            <div class="value-body">{v.body}</div>
          </div>
        ))}
      </div>
      <div class="values-row values-row-bottom">
        {valuesBottom.map((v) => (
          <div class="value-card">
            <div class="value-num">{v.num}</div>
            <div class="value-body">{v.body}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── INTRO ── */
  .about-intro {
    padding: 56px clamp(20px,5vw,48px) 64px;
    border-bottom: 1px solid #1e1e1e;
  }
  .breadcrumb { display: flex; gap: 8px; align-items: center; font-size: 12px; color: #5a5a56; margin-bottom: 16px; }
  .breadcrumb a { color: #5a5a56; }
  .breadcrumb a:hover { color: #fff; }
  .about-intro h1 { margin: 0 0 26px; font-size: clamp(27px,5.2vw,44px); font-weight: 300; letter-spacing: -.01em; line-height: 1.08; color: #fff; }
  .about-intro p { margin: 0; max-width: 820px; font-size: 19px; line-height: 1.72; color: #c9c9c6; text-wrap: pretty; }

  /* ── STATS ── */
  .stat-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
    border-bottom: 1px solid #1e1e1e;
  }
  .stat-cell { padding: 32px clamp(20px,5vw,48px); border-right: 1px solid #1e1e1e; }
  .stat-cell:last-child { border-right: none; }
  .stat-num { font-size: clamp(24px,4.2vw,36px); font-weight: 300; color: #f2f2f0; }
  .stat-plus { color: #5b8def; }
  .stat-label { font-size: 13px; color: #8a8a86; margin-top: 5px; }

  /* ── MISSION / VISION ── */
  .mv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px,100%),1fr));
    gap: 1px;
    background: #1e1e1e;
    border-bottom: 1px solid #1e1e1e;
  }
  .mv-cell { background: #0a0a0a; padding: 72px clamp(20px,5vw,48px); }
  .mv-cell p { margin: 0; font-size: clamp(19px,3vw,24px); line-height: 1.5; font-weight: 300; color: #f2f2f0; text-wrap: pretty; }

  /* ── CORE VALUES ── */
  .values { padding: 80px clamp(20px,5vw,48px) 100px; }
  .values h2 { margin: 0 0 10px; font-size: clamp(24px,4.2vw,36px); font-weight: 300; text-transform: uppercase; letter-spacing: .01em; color: #fff; }
  .values-lead { margin: 0 0 40px; font-size: 16px; color: #9a9a96; }
  .values-panel {
    border: 1px solid #1e1e1e; border-radius: 8px; overflow: hidden; background: #1e1e1e;
    display: flex; flex-direction: column; gap: 1px;
  }
  .values-row { display: grid; gap: 1px; }
  .values-row-top { grid-template-columns: repeat(auto-fit, minmax(min(240px,100%),1fr)); }
  .values-row-bottom { grid-template-columns: repeat(auto-fit, minmax(min(280px,100%),1fr)); }
  .value-card { background: #0d0d0d; padding: 36px 32px; display: flex; flex-direction: column; gap: 16px; }
  .value-num { font: 600 12px ui-monospace, monospace; color: #d92632; letter-spacing: .1em; }
  .value-body { font-size: 16.5px; line-height: 1.6; color: #e2e2de; text-wrap: pretty; }
</style>
