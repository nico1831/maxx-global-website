---
const CONFIG: Record<string, { text: string; border: string; label: string }> = {
  available:    { text: '#8fb79b', border: '#3c5a45', label: 'Available' },
  indent:       { text: '#c2a768', border: '#5c4e2e', label: 'Indent Order' },
  preorder:     { text: '#7ca8e0', border: '#2a4a6e', label: 'Pre-Order' },
  discontinued: { text: '#6a6a66', border: '#3a3a38', label: 'Discontinued' },
}

interface Props {
  availability: string
}

const { availability } = Astro.props
const c = CONFIG[availability] ?? CONFIG.indent
---

<span class="avail-tag" style={`color:${c.text};border-color:${c.border}`}>
  {c.label}
</span>

<style>
  .avail-tag {
    display: inline-block;
    font: 700 9.5px Manrope, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 6px 9px;
    border: 1px solid;
    border-radius: 0;
  }
</style>
