---
import AvailabilityBadge from './AvailabilityBadge.astro'
import { urlFor } from '../lib/sanity'

interface Props {
  product: {
    _id: string
    title: string
    slug: { current: string }
    modelCode?: string
    availability: string
    brand: { name: string; slug: { current: string } }
    primaryCategory: {
      title: string
      slug: { current: string }
      parent?: { title: string; slug: { current: string } } | null
    }
    image?: { asset: { _ref: string }; alt?: string } | null
  }
}

const { product } = Astro.props
const imageUrl = product.image?.asset
  ? urlFor(product.image).width(560).fit('max').format('webp').url()
  : null
---

<a href={`/products/${product.slug.current}`} class="product-card">
  <div class="product-img">
    {imageUrl ? (
      <img src={imageUrl} alt={product.image?.alt ?? product.title} loading="lazy" width="280" height="210">
    ) : (
      <span class="img-ph">[ product photo ]</span>
    )}
  </div>
  <div class="product-info">
    <div class="product-brand">{product.brand.name}</div>
    <div class="product-title">{product.title}</div>
    <div class="product-model">
      {product.modelCode && <>{product.modelCode}</>}
      {product.modelCode && product.primaryCategory.title && ' · '}
      {product.primaryCategory.title}
    </div>
    <div class="product-footer">
      <AvailabilityBadge availability={product.availability} />
      <span class="product-cta">Details →</span>
    </div>
  </div>
</a>

<style>
  .product-card {
    border: 1px solid #1e1e1e;
    border-radius: 6px;
    overflow: hidden;
    background: #0d0d0d;
    display: block;
    color: inherit;
    text-decoration: none;
    transition: border-color .18s ease;
  }
  .product-card:hover { border-color: #3a3a38; }

  .product-img {
    height: 210px;
    overflow: hidden;
    background: #101010;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-img img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .img-ph { color: #4a4a48; font: 11px ui-monospace, monospace; }

  .product-info { padding: 20px; }
  .product-brand {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    color: #5b8def;
    text-transform: uppercase;
  }
  .product-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    margin: 6px 0 4px;
    color: #f2f2f0;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.3em * 2);
  }
  .product-model {
    font-size: 12px;
    color: #8a8a86;
    font-family: ui-monospace, monospace;
  }
  .product-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
  }
  .product-cta {
    font-size: 13px;
    font-weight: 600;
    color: #c9c9c6;
    white-space: nowrap;
  }

  /* Two per row, like the homepage category cards, with the photo and the text
     as separate panels. The fixed photo height keeps the divider level across a
     row, and height: 100% lets shorter cards match their row's tallest.
     Grids holding this card need the same 767px / 420px breakpoints. */
  @media (max-width: 767px) {
    .product-card {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      border: none;
      border-radius: 4px;
      background: #141414;
    }
    .product-img {
      flex: none;
      height: 170px;
      padding: 36px 10px 8px;
      background: #fff;
    }
    .product-info {
      flex: 1 1 auto;
      min-width: 0;
      padding: 12px 14px;
      border-top: 1px solid #2a2a28;
    }
    .product-brand {
      font-size: 9.5px;
      letter-spacing: .06em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .product-title { font-size: 14px; margin: 3px 0 2px; }
    .product-model {
      font: 500 11px Manrope, sans-serif;
      color: #9a9a96;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .product-footer { position: absolute; top: 8px; left: 8px; margin: 0; background: #0a0a0a; }
    .product-cta { display: none; }
  }
  @media (max-width: 420px) {
    .product-img { height: 150px; padding: 34px 8px 6px; }
    .product-info { padding: 10px 12px; }
    .product-title { font-size: 13px; }
    .product-model { font-size: 10px; }
  }
</style>
